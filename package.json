{
  "name": "webtorrent-desktop",
  "description": "WebTorrent, the streaming torrent client. For Mac, Windows, and Linux.",
  "version": "0.24.0",
  "author": {
    "name": "WebTorrent, LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bugs": {
    "url": "https://github.com/webtorrent/webtorrent-desktop/issues"
  },
  "dependencies": {
    "airplayer": "github:webtorrent/airplayer#fix-security",
    "application-config": "2.0.0",
    "auto-launch": "^5.0.6",
    "bitfield": "4.1.0",
    "capture-frame": "4.0.0",
    "chokidar": "3.6.0",
    "chromecasts": "1.10.2",
    "create-torrent": "5.0.9",
    "debounce": "1.2.1",
    "dlnacasts": "0.1.0",
    "drag-drop": "7.2.0",
    "es6-error": "4.1.1",
    "fn-getter": "1.0.0",
    "iso-639-1": "2.1.15",
    "languagedetect": "2.0.0",
    "location-history": "1.1.2",
    "material-ui": "0.20.2",
    "music-metadata": "11.14.0",
    "network-address": "1.1.2",
    "parse-torrent": "9.1.5",
    "prettier-bytes": "1.0.4",
    "prop-types": "15.8.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "rimraf": "6.1.3",
    "run-parallel": "1.2.0",
    "semver": "7.8.5",
    "simple-concat": "1.0.1",
    "srt-to-vtt": "1.1.3",
    "vlc-command": "1.2.0",
    "webtorrent": "^3.0.16",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.6.0",
    "@electron/packager": "20.0.4",
    "cross-zip": "^4.0.1",
    "depcheck": "1.4.7",
    "electron": "43.2.0",
    "electron-installer-debian": "3.2.0",
    "electron-installer-redhat": "3.4.0",
    "electron-winstaller": "5.4.4",
    "esbuild": "^0.28.1",
    "gh-release": "8.1.0",
    "minimist": "1.2.8",
    "nodemon": "3.1.14",
    "open": "8.4.2",
    "playwright": "1.61.1",
    "plist": "3.1.1",
    "pngjs": "7.0.0",
    "run-series": "1.1.9",
    "standard": "^17.1.2",
    "tape": "5.10.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "homepage": "https://webtorrent.io",
  "keywords": [
    "desktop",
    "electron",
    "electron-app",
    "hybrid webtorrent client",
    "mad science",
    "torrent",
    "torrent client",
    "webtorrent"
  ],
  "license": "MIT",
  "main": "index.js",
  "overrides": {
    "isomorphic-fetch": {
      "node-fetch": "^2.6.13"
    },
    "plist": "3.1.1",
    "protobufjs": "8.7.1",
    "xml2js": "^0.6.2"
  },
  "private": true,
  "productName": "WebTorrent",
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/webtorrent-desktop.git"
  },
  "scripts": {
    "build": "node ./bin/build.js",
    "clean": "node ./bin/clean.js",
    "gh-release": "gh-release",
    "install-system-deps": "brew install fakeroot dpkg rpm",
    "open-config": "node ./bin/open-config.js",
    "package": "node ./bin/package.js",
    "start": "npm run build && electron .",
    "test": "standard && depcheck --ignores=standard --ignore-dirs=build,dist",
    "test-integration": "npm run build && node ./test",
    "update-authors": "./bin/update-authors.sh",
    "watch": "nodemon --exec \"npm run start\" --ext js,css --ignore build/ --ignore dist/"
  },
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ]
  }
}
